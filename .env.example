# 各模型服务商的 API 密钥
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
USE_AWS_BEDROCK=false

#Vertex AI
GOOGLE_APPLICATION_CREDENTIALS=

# Amazon Bedrock 知识库 ID
AWS_KB_ID="<knowledge-base-id>"

# 使用模拟模型进行测试
USE_FAKE_MODEL=false

# 设置默认模型
DEFAULT_MODEL=

# 如果 MODEL 设置为 "openai-compatible"，请配置以下变量
# 这是一种灵活的接入方案。如果需要多个模型选项，仍需在 models.py 中添加。
COMPATIBLE_MODEL=
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=

# Web 服务器配置
HOST=0.0.0.0
PORT=8080

# 认证密钥；设置后，请求必须在 HTTP 请求头中携带 Bearer 令牌。
# 警告：未设置时，所有 API 接口均无需认证。生产环境务必设置。
AUTH_SECRET=

# LangSmith 配置
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=default
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# 应用运行模式；值为 "dev" 时启用 uvicorn 自动重载
MODE=

# 数据库类型。
# 值为 "postgres" 时，需要配置 PostgreSQL 相关环境变量。
# 值为 "sqlite" 时，可通过 SQLITE_DB_PATH 自定义数据库文件路径。
DATABASE_TYPE=

# DATABASE_TYPE=sqlite 时的可选配置
SQLITE_DB_PATH=

# DATABASE_TYPE=postgres 时的配置
# Docker Compose 默认配置（可直接用于 docker-compose 启动）
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=

# 可在 Postgres 连接管理器中通过此应用名称识别 AST 的连接
# POSTGRES_APPLICATION_NAME = "agent-service-toolkit"
# 通过以下值自定义连接池大小；检查点保存器和存储组件各自拥有独立的连接池
# POSTGRES_MIN_CONNECTIONS_PER_POOL=1
# POSTGRES_MAX_CONNECTIONS_PER_POOL= 3

# DATABASE_TYPE=mongo 时的配置
# 本地测试所用的 MongoDB 容器配置见 docker/compose.mongo.yaml
MONGO_HOST=
MONGO_PORT=
MONGO_DB=
# MONGO_USER=
# MONGO_PASSWORD=
# MONGO_AUTH_SOURCE=
# MONGO_TLS=false

# OpenWeatherMap API 密钥
OPENWEATHERMAP_API_KEY=

# 运行 Ollama 时添加以下配置
# OLLAMA_MODEL=llama3.2
# 注意：服务在 Docker 中运行、Ollama 在宿主机运行时，请设置 OLLAMA_BASE_URL
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# 运行 Azure OpenAI 时添加以下配置
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT_MAP={"gpt-5": "gpt-5-deployment", "gpt-5-mini": "gpt-5-mini-deployment"}

# Agent 地址：供 Streamlit 应用使用，未设置时默认为 http://{HOST}:{PORT}
# AGENT_URL=http://localhost:8080

# Langfuse 配置
#LANGFUSE_TRACING=true
#LANGFUSE_PUBLIC_KEY=pk-...
#LANGFUSE_SECRET_KEY=sk-lf-....
#LANGFUSE_HOST=http://localhost:3000

# GitHub MCP Agent 配置
# GitHub 个人访问令牌（GitHub MCP 服务器必需）
# 未设置时，GitHub MCP Agent 将没有可用工具
GITHUB_PAT=

# 语音功能（可选）
# 注意：语音功能在客户端（Streamlit 应用）配置，而不是服务端（API）。
# 需要设置 OPENAI_API_KEY（见上文）。
# 设置服务商名称以启用语音输入或输出；留空则禁用。
VOICE_STT_PROVIDER=        # Speech-to-text provider (only 'openai' supported currently)
VOICE_TTS_PROVIDER=        # Text-to-speech provider (only 'openai' supported currently)
